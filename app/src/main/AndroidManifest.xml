<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet: cópia de segurança no Google Drive -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Câmera: foto da capa e leitura do código de barras (opcional: o app funciona sem) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        As permissões de armazenamento foram removidas: a galeria usa o seletor de fotos
        do Android e os arquivos ficam na pasta do próprio app, sem precisar de permissão.
    -->

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LivrariaDigitalECLB"
        tools:targetApi="31">

        <!--
            Só a tela inicial pode ser aberta por outros apps (antes todas eram "exported").
            A orientação (horizontal no tablet, livre no celular) é definida em BaseActivity.
        -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.catalogo.CatalogoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.catalogo.CadastrarLivroActivity"
            android:exported="false" />

        <activity
            android:name=".ui.catalogo.CameraXCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.LivrariaDigitalECLB.Camera" />

        <activity
            android:name=".ui.realizarvenda.RealizarVendaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.concluirvenda.ConcluirVendaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pedidos.PedidosActivity"
            android:exported="false" />

        <activity
            android:name=".ui.relatorios.RelatoriosActivity"
            android:exported="false" />

        <activity
            android:name=".ui.backup.BackupActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.projeto.livrariadigitaleclb.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
