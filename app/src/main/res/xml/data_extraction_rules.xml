<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup automático do Android (Android 12+) e transferência para um tablet novo.
    Proteção extra, além da cópia no Google Drive feita pelo próprio app.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="capas/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="capas/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
