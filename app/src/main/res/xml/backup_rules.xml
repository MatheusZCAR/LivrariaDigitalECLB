<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup automático do Android (Android 11 e anteriores).
    É uma proteção extra, além da cópia no Google Drive feita pelo próprio app:
    inclui banco de dados, capas e configurações.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="capas/" />
    <include domain="sharedpref" path="." />
</full-backup-content>
