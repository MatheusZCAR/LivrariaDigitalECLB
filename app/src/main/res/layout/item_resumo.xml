<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@color/primaria_clara"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/rotuloResumo"
        style="@style/Livraria.Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        tools:text="Total vendido" />

    <TextView
        android:id="@+id/valorResumo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/primaria_escura"
        android:textSize="@dimen/texto_valor"
        android:textStyle="bold"
        tools:text="R$ 1.250,00" />
</LinearLayout>
