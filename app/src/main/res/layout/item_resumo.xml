<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@color/primaria_clara"
    android:padding="16dp">

    <TextView
        android:id="@+id/rotuloResumo"
        style="@style/Livraria.Texto.Secundario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Total vendido" />

    <TextView
        android:id="@+id/valorResumo"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/primaria_escura"
        android:textSize="@dimen/texto_valor"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="@dimen/texto_valor"
        app:autoSizeMinTextSize="18sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rotuloResumo"
        tools:text="R$ 1.250,00" />
</androidx.constraintlayout.widget.ConstraintLayout>
