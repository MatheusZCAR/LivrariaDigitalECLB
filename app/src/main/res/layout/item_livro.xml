<?xml version="1.0" encoding="utf-8"?>
<!-- Um livro na grade (usado no Catálogo e na tela de Vender). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartaoLivro"
    style="@style/Widget.Livraria.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:strokeColor="@color/primaria"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/areaCapa"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_capa_vazia"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Desenho mostrado quando o livro não tem foto -->
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:alpha="0.85"
                android:contentDescription="@null"
                android:src="@drawable/bg_placeholder_livro" />

            <ImageView
                android:id="@+id/imgCapaLivro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/capa_livro"
                android:scaleType="centerCrop"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/txtEsgotadoBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@color/perigo"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/esgotado"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/txtNaVenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_selo"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2 na venda"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/areaCapa">

            <TextView
                android:id="@+id/txtTituloLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:minLines="2"
                android:textColor="@color/texto"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="O Caminho da Luz" />

            <TextView
                android:id="@+id/txtAutorLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/texto_secundario"
                android:textSize="17sp"
                tools:text="Autor do livro" />

            <TextView
                android:id="@+id/txtPrecoLivro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/primaria"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="R$ 25,00" />

            <TextView
                android:id="@+id/txtEstoqueLivro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="17sp"
                tools:text="5 em estoque" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
