<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.Livraria.Botao.Voltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:text="@string/voltar" />

    <TextView
        android:id="@+id/txtDicaCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="#99000000"
        android:padding="12dp"
        android:text="@string/camera_dica"
        android:textColor="@color/white"
        android:textSize="@dimen/texto_corpo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCapture"
        style="@style/Widget.Livraria.Botao.Branco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:minHeight="88dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:text="@string/capturar_foto"
        android:textSize="26sp"
        app:icon="@drawable/ic_camera"
        app:iconSize="40dp" />

    <ProgressBar
        android:id="@+id/progresso"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
