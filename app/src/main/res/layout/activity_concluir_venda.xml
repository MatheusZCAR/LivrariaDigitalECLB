<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".ui.concluirvenda.ConcluirVendaActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Livros da venda -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_tela"
            android:paddingTop="20dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/Livraria.Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/itens_da_venda" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCarrinho"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                tools:listitem="@layout/item_carrinho" />
        </LinearLayout>

        <!-- Pagamento -->
        <ScrollView
            android:id="@+id/rolagemPagamento"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/superficie"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <TextView
                    style="@style/Livraria.Texto.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/como_vai_pagar" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupoPagamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDinheiro"
                        style="@style/Widget.Livraria.Botao.Escolha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="@string/dinheiro"
                        app:icon="@drawable/ic_dinheiro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPix"
                        style="@style/Widget.Livraria.Botao.Escolha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="@string/pix"
                        app:icon="@drawable/ic_celular" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDebito"
                        style="@style/Widget.Livraria.Botao.Escolha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="Cartão de débito"
                        app:icon="@drawable/ic_cartao" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCredito"
                        style="@style/Widget.Livraria.Botao.Escolha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="Cartão de crédito"
                        app:icon="@drawable/ic_cartao" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/txtErroPagamento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Escolha uma das opções acima."
                    android:textColor="@color/perigo"
                    android:textSize="@dimen/texto_rotulo"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Dinheiro: troco -->
                <LinearLayout
                    android:id="@+id/secaoDinheiro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoRecebido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/valor_recebido"
                        app:helperText="Opcional: serve para calcular o troco"
                        app:prefixText="R$ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtRecebido"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789,."
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:maxLength="10" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/linhaAtalhosValor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnValorExato"
                            style="@style/Widget.Livraria.Botao.Contorno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1.4"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/valor_exato"
                            android:textSize="18sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnValor20"
                            style="@style/Widget.Livraria.Botao.Contorno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="R$ 20"
                            android:textSize="18sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnValor50"
                            style="@style/Widget.Livraria.Botao.Contorno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="R$ 50"
                            android:textSize="18sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnValor100"
                            style="@style/Widget.Livraria.Botao.Contorno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="R$ 100"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtTroco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/sucesso_claro"
                        android:padding="16dp"
                        android:textColor="@color/sucesso"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Troco: R$ 25,00"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Crédito: parcelas -->
                <LinearLayout
                    android:id="@+id/secaoCredito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Livraria.Texto.Corpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Em quantas vezes?"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/seletorParcelas"
                            layout="@layout/view_seletor_quantidade" />

                        <TextView
                            android:id="@+id/txtParcelas"
                            style="@style/Livraria.Texto.Corpo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            tools:text="À vista: R$ 75,00" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Total -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@color/primaria_clara"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtTotalItens"
                        style="@style/Livraria.Texto.Corpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Total a pagar (3 livros)" />

                    <TextView
                        android:id="@+id/txtValorTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primaria_escura"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        tools:text="R$ 75,00" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmar"
                    style="@style/Widget.Livraria.Botao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="84dp"
                    android:text="@string/confirmar_venda"
                    android:textSize="26sp"
                    app:icon="@drawable/ic_ok"
                    app:iconSize="36dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
