<?xml version="1.0" encoding="utf-8"?>
<!-- Catálogo: o mesmo layout serve para celular e tablet (só o texto do botão muda). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ui.catalogo.CatalogoActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoBusca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:hint="@string/buscar_livro"
        app:endIconMode="clear_text"
        app:layout_constraintEnd_toStartOf="@id/btnCadastrarLivro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraTopo"
        app:startIconDrawable="@drawable/ic_busca">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtBusca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCadastrarLivro"
        style="@style/Widget.Livraria.Botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/margem_tela"
        android:text="@string/cadastrar_livro_botao"
        app:icon="@drawable/ic_adicionar"
        app:layout_constraintBottom_toBottomOf="@id/campoBusca"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/campoBusca" />

    <TextView
        android:id="@+id/txtContagem"
        style="@style/Livraria.Texto.Secundario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/margem_tela"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/campoBusca"
        tools:text="42 livros cadastrados" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLivros"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtContagem"
        tools:listitem="@layout/item_livro" />

    <TextView
        android:id="@+id/txtVazio"
        style="@style/Livraria.Texto.Corpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:textSize="@dimen/texto_grande"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recyclerLivros"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/recyclerLivros"
        tools:text="@string/catalogo_vazio"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
