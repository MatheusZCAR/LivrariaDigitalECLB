<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".ui.catalogo.CatalogoActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/margem_tela">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoBusca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/buscar_livro"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_busca">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCadastrarLivro"
            style="@style/Widget.Livraria.Botao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:minHeight="72dp"
            android:text="@string/cadastrar_livro"
            app:icon="@drawable/ic_adicionar" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtContagem"
        style="@style/Livraria.Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginTop="8dp"
        tools:text="42 livros cadastrados" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLivros"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_livro" />

        <TextView
            android:id="@+id/txtVazio"
            style="@style/Livraria.Texto.Corpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textSize="@dimen/texto_grande"
            android:visibility="gone"
            tools:text="@string/catalogo_vazio"
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
