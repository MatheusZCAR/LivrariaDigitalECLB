<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".ui.relatorios.RelatoriosActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Escolha do período -->
        <ScrollView
            android:layout_width="320dp"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <TextView
                    style="@style/Livraria.Texto.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver vendas de:" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupoPeriodo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHoje"
                        style="@style/Widget.Livraria.Botao.Escolha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hoje" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSemana"
                        style="@style/Widget.Livraria.Botao.Escolha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/esta_semana" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMes"
                        style="@style/Widget.Livraria.Botao.Escolha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/este_mes" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEscolherDatas"
                        style="@style/Widget.Livraria.Botao.Escolha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/escolher_datas"
                        app:icon="@drawable/ic_calendario" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImprimir"
                    style="@style/Widget.Livraria.Botao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:minHeight="@dimen/altura_botao_grande"
                    android:text="@string/imprimir_ou_enviar"
                    app:icon="@drawable/ic_imprimir" />
            </LinearLayout>
        </ScrollView>

        <!-- Resultado -->
        <ScrollView
            android:id="@+id/rolagemResultado"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/superficie"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <TextView
                    android:id="@+id/txtPeriodo"
                    style="@style/Livraria.Texto.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    tools:text="Hoje, domingo, 19/10/2026" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/resumoTotal"
                        layout="@layout/item_resumo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1.3" />

                    <include
                        android:id="@+id/resumoVendas"
                        layout="@layout/item_resumo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/resumoLivros"
                        layout="@layout/item_resumo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSemVendas"
                    style="@style/Livraria.Texto.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:text="@string/sem_vendas"
                    android:textSize="@dimen/texto_grande"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/secaoDetalhes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Livraria.Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/por_forma_pagamento"
                        android:textSize="@dimen/texto_grande" />

                    <LinearLayout
                        android:id="@+id/listaFormas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/Livraria.Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/mais_vendidos"
                        android:textSize="@dimen/texto_grande" />

                    <LinearLayout
                        android:id="@+id/listaMaisVendidos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/Livraria.Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/lista_vendas"
                        android:textSize="@dimen/texto_grande" />

                    <TextView
                        style="@style/Livraria.Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registrou algo errado? Use “Cancelar venda”: os livros voltam para o estoque." />

                    <LinearLayout
                        android:id="@+id/listaVendas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
