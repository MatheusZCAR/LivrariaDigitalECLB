<?xml version="1.0" encoding="utf-8"?>
<!-- Relatórios — CELULAR (uma coluna) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ui.relatorios.RelatoriosActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rolagemResultado"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/barraTopo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margem_tela">

            <TextView
                android:id="@+id/txtVerVendas"
                style="@style/Livraria.Texto.Titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ver vendas de:"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoPeriodo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                app:selectionRequired="true"
                app:singleSelection="true"
                app:layout_constraintTop_toBottomOf="@id/txtVerVendas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHoje"
                    style="@style/Widget.Livraria.Botao.Escolha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hoje" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSemana"
                    style="@style/Widget.Livraria.Botao.Escolha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/esta_semana" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMes"
                    style="@style/Widget.Livraria.Botao.Escolha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/este_mes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEscolherDatas"
                    style="@style/Widget.Livraria.Botao.Escolha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/escolher_datas"
                    app:icon="@drawable/ic_calendario" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/txtPeriodo"
                style="@style/Livraria.Texto.Titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                tools:text="Hoje, segunda-feira, 19/10/2026"
                app:layout_constraintTop_toBottomOf="@id/grupoPeriodo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <include
                android:id="@+id/resumoTotal"
                layout="@layout/item_resumo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/txtPeriodo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <include
                android:id="@+id/resumoVendas"
                layout="@layout/item_resumo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintTop_toBottomOf="@id/resumoTotal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/resumoLivros" />

            <include
                android:id="@+id/resumoLivros"
                layout="@layout/item_resumo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_constraintTop_toTopOf="@id/resumoVendas"
                app:layout_constraintStart_toEndOf="@id/resumoVendas"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImprimir"
                style="@style/Widget.Livraria.Botao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="@dimen/altura_botao_grande"
                android:text="@string/imprimir_ou_enviar"
                app:icon="@drawable/ic_imprimir"
                app:layout_constraintTop_toBottomOf="@id/resumoVendas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtSemVendas"
                style="@style/Livraria.Texto.Corpo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sem_vendas"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:textSize="@dimen/texto_grande"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/btnImprimir"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/secaoDetalhes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/txtSemVendas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtTituloFormas"
                    style="@style/Livraria.Texto.Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/por_forma_pagamento"
                    android:layout_marginTop="24dp"
                    android:textSize="@dimen/texto_grande"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/listaFormas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/txtTituloFormas"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtTituloMaisVendidos"
                    style="@style/Livraria.Texto.Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/mais_vendidos"
                    android:layout_marginTop="24dp"
                    android:textSize="@dimen/texto_grande"
                    app:layout_constraintTop_toBottomOf="@id/listaFormas"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/listaMaisVendidos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/txtTituloMaisVendidos"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtTituloVendas"
                    style="@style/Livraria.Texto.Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/lista_vendas"
                    android:layout_marginTop="24dp"
                    android:textSize="@dimen/texto_grande"
                    app:layout_constraintTop_toBottomOf="@id/listaMaisVendidos"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtDicaCancelar"
                    style="@style/Livraria.Texto.Secundario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Registrou algo errado? Use “Cancelar venda”: os livros voltam para o estoque."
                    app:layout_constraintTop_toBottomOf="@id/txtTituloVendas"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/listaVendas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/txtDicaCancelar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
