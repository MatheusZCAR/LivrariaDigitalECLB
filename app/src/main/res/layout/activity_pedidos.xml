<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".ui.pedidos.PedidosActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo" />

    <TextView
        android:id="@+id/txtResumo"
        style="@style/Livraria.Texto.Corpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/margem_tela"
        android:text="@string/pedidos_subtitulo" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaPedidos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margem_tela"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/margem_tela"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_pedido" />

        <TextView
            android:id="@+id/txtVazio"
            style="@style/Livraria.Texto.Corpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/pedidos_vazio"
            android:textSize="@dimen/texto_grande"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdicionarLivro"
            style="@style/Widget.Livraria.Botao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:minHeight="@dimen/altura_botao_grande"
            android:text="@string/adicionar_livro"
            app:icon="@drawable/ic_adicionar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImprimirLista"
            style="@style/Widget.Livraria.Botao.Contorno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:minHeight="@dimen/altura_botao_grande"
            android:text="@string/imprimir_ou_enviar"
            app:icon="@drawable/ic_imprimir" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimparLista"
            style="@style/Widget.Livraria.Botao.Perigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao_grande"
            android:text="@string/limpar_lista"
            app:icon="@drawable/ic_lixeira" />
    </LinearLayout>
</LinearLayout>
