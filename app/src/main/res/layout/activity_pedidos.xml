<?xml version="1.0" encoding="utf-8"?>
<!-- Lista de pedidos — CELULAR (botões em duas linhas) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ui.pedidos.PedidosActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtResumo"
        style="@style/Livraria.Texto.Corpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="@dimen/margem_tela"
        android:text="@string/pedidos_subtitulo"
        app:layout_constraintTop_toBottomOf="@id/barraTopo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaPedidos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="12dp"
        tools:listitem="@layout/item_pedido"
        app:layout_constraintTop_toBottomOf="@id/txtResumo"
        app:layout_constraintBottom_toTopOf="@id/barraAcoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtVazio"
        style="@style/Livraria.Texto.Corpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/pedidos_vazio"
        android:textSize="@dimen/texto_grande"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/listaPedidos"
        app:layout_constraintBottom_toBottomOf="@id/listaPedidos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/barraAcoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:elevation="8dp"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdicionarLivro"
            style="@style/Widget.Livraria.Botao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao_grande"
            android:text="@string/adicionar_livro"
            app:icon="@drawable/ic_adicionar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImprimirLista"
            style="@style/Widget.Livraria.Botao.Contorno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao_grande"
            android:text="@string/imprimir_lista"
            app:icon="@drawable/ic_imprimir"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnAdicionarLivro"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnLimparLista" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimparLista"
            style="@style/Widget.Livraria.Botao.Perigo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao_grande"
            android:text="@string/limpar_lista"
            app:icon="@drawable/ic_lixeira"
            app:layout_constraintTop_toTopOf="@id/btnImprimirLista"
            app:layout_constraintBottom_toBottomOf="@id/btnImprimirLista"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnImprimirLista" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
