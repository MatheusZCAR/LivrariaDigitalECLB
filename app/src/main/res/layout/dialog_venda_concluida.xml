<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_ok"
        app:tint="@color/sucesso" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Venda registrada!"
        android:textColor="@color/sucesso"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtResumoVenda"
        style="@style/Livraria.Texto.Corpo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        tools:text="Total: R$ 75,00 — Dinheiro" />

    <TextView
        android:id="@+id/txtTrocoFinal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/sucesso_claro"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/sucesso"
        android:textSize="36sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Troco: R$ 25,00"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImprimirRecibo"
        style="@style/Widget.Livraria.Botao.Contorno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Imprimir recibo"
        app:icon="@drawable/ic_imprimir" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviarRecibo"
        style="@style/Widget.Livraria.Botao.Contorno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enviar recibo (WhatsApp, e-mail…)"
        app:icon="@drawable/ic_compartilhar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNovaVenda"
        style="@style/Widget.Livraria.Botao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="@dimen/altura_botao_grande"
        android:text="Concluir"
        android:textSize="24sp"
        app:icon="@drawable/ic_ok" />
</LinearLayout>
