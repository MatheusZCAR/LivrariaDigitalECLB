<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/iconeSucesso"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ok"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/sucesso" />

        <TextView
            android:id="@+id/txtVendaRegistrada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Venda registrada!"
            android:textColor="@color/sucesso"
            android:textSize="@dimen/texto_valor"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconeSucesso" />

        <TextView
            android:id="@+id/txtResumoVenda"
            style="@style/Livraria.Texto.Corpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtVendaRegistrada"
            tools:text="Total: R$ 75,00 — Dinheiro" />

        <TextView
            android:id="@+id/txtTrocoFinal"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:maxLines="1"
            app:autoSizeMaxTextSize="@dimen/texto_destaque"
            app:autoSizeMinTextSize="20sp"
            app:autoSizeTextType="uniform"
            android:layout_marginTop="16dp"
            android:background="@color/sucesso_claro"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="@color/sucesso"
            android:textSize="@dimen/texto_destaque"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtResumoVenda"
            tools:text="Troco: R$ 25,00"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImprimirRecibo"
            style="@style/Widget.Livraria.Botao.Contorno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Imprimir recibo"
            app:icon="@drawable/ic_imprimir"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTrocoFinal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarRecibo"
            style="@style/Widget.Livraria.Botao.Contorno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enviar recibo (WhatsApp, e-mail…)"
            app:icon="@drawable/ic_compartilhar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnImprimirRecibo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNovaVenda"
            style="@style/Widget.Livraria.Botao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="@dimen/altura_botao_grande"
            android:text="Concluir"
            app:icon="@drawable/ic_ok"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnEnviarRecibo" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
