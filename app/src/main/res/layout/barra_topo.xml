<?xml version="1.0" encoding="utf-8"?>
<!-- Barra do topo padrão: botão "Voltar" grande e título da tela. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/primaria"
    android:minHeight="@dimen/altura_barra_topo"
    android:paddingStart="@dimen/margem_tela"
    android:paddingEnd="@dimen/margem_tela"
    android:paddingBottom="4dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoltar"
        style="@style/Widget.Livraria.Botao.Voltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voltar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTituloTela"
        style="@style/Livraria.Texto.TituloTela"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnVoltar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="4dp"
        tools:text="Título da tela" />
</androidx.constraintlayout.widget.ConstraintLayout>
