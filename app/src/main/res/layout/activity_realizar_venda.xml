<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".ui.realizarvenda.RealizarVendaActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/margem_tela">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoBusca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/buscar_livro"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_busca">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            style="@style/Widget.Livraria.Botao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:minHeight="72dp"
            android:text="@string/ler_codigo"
            app:icon="@drawable/ic_codigo_barras" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtDica"
        style="@style/Livraria.Texto.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/margem_tela"
        android:text="@string/venda_dica" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProdutos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_livro" />

        <TextView
            android:id="@+id/txtVazio"
            style="@style/Livraria.Texto.Corpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textSize="@dimen/texto_grande"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Barra da venda em andamento -->
    <LinearLayout
        android:id="@+id/layoutCarrinho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaria"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_carrinho_venda"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTotalItens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/texto_corpo"
                tools:text="3 livros na venda" />

            <TextView
                android:id="@+id/txtValorTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/texto_valor"
                android:textStyle="bold"
                tools:text="R$ 150,00" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimparCarrinho"
            style="@style/Widget.Livraria.Botao.Contorno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/esvaziar"
            android:textColor="@color/white"
            app:icon="@drawable/ic_lixeira"
            app:iconTint="@color/white"
            app:strokeColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerCarrinho"
            style="@style/Widget.Livraria.Botao.Branco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao_grande"
            android:text="@string/finalizar_venda"
            android:textSize="24sp"
            app:icon="@drawable/ic_avancar"
            app:iconGravity="end" />
    </LinearLayout>
</LinearLayout>
