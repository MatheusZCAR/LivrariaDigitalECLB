<?xml version="1.0" encoding="utf-8"?>
<!-- Cadastrar/editar livro — TABLET (foto ao lado do formulário) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ui.catalogo.CadastrarLivroActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rolagem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/barraTopo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margem_tela">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFoto"
                style="@style/Widget.Livraria.Cartao"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtFotoTitulo"
                        style="@style/Livraria.Texto.Titulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/foto_da_capa"
                        android:textSize="@dimen/texto_grande"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/fundoCapaCadastro"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/altura_capa_cadastro"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_capa_vazia"
                        app:layout_constraintDimensionRatio="3:4"
                        app:layout_constraintTop_toBottomOf="@id/txtFotoTitulo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:contentDescription="@null"
                        android:src="@drawable/bg_placeholder_livro"
                        app:layout_constraintTop_toTopOf="@id/fundoCapaCadastro"
                        app:layout_constraintBottom_toBottomOf="@id/fundoCapaCadastro"
                        app:layout_constraintStart_toStartOf="@id/fundoCapaCadastro"
                        app:layout_constraintEnd_toEndOf="@id/fundoCapaCadastro" />

                    <ImageView
                        android:id="@+id/imgPreviewCapa"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/capa_livro"
                        android:scaleType="centerCrop"
                        android:visibility="invisible"
                        app:layout_constraintTop_toTopOf="@id/fundoCapaCadastro"
                        app:layout_constraintBottom_toBottomOf="@id/fundoCapaCadastro"
                        app:layout_constraintStart_toStartOf="@id/fundoCapaCadastro"
                        app:layout_constraintEnd_toEndOf="@id/fundoCapaCadastro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTirarFoto"
                        style="@style/Widget.Livraria.Botao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/tirar_foto"
                        app:icon="@drawable/ic_camera"
                        app:layout_constraintTop_toBottomOf="@id/fundoCapaCadastro"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGaleria"
                        style="@style/Widget.Livraria.Botao.Contorno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/escolher_da_galeria"
                        app:icon="@drawable/ic_galeria"
                        app:layout_constraintTop_toBottomOf="@id/btnTirarFoto"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemoverFoto"
                        style="@style/Widget.Livraria.Botao.Perigo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/remover_foto"
                        android:visibility="gone"
                        app:icon="@drawable/ic_lixeira"
                        tools:visibility="visible"
                        app:layout_constraintTop_toBottomOf="@id/btnGaleria"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFormulario"
                style="@style/Widget.Livraria.Cartao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margem_tela"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardFoto"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoCodigo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnLerCodigo"
                        android:hint="@string/codigo_de_barras">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCodigoBarras"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLength="40" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLerCodigo"
                        style="@style/Widget.Livraria.Botao.Contorno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ler_codigo"
                        app:icon="@drawable/ic_codigo_barras"
                        app:layout_constraintTop_toTopOf="@id/campoCodigo"
                        app:layout_constraintBottom_toBottomOf="@id/campoCodigo"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoTitulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/campoCodigo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:hint="@string/titulo_do_livro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences"
                            android:maxLength="200" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoAutor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/campoTitulo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:hint="@string/autor_opcional">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtAutor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:maxLength="120" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guiaMeio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoPreco"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintTop_toBottomOf="@id/campoAutor"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/guiaMeio"
                        android:hint="@string/preco"
                        app:helperText="Ex.: 25,90"
                        app:prefixText="R$ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPreco"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789,."
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:maxLength="12" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoQuantidade"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintTop_toBottomOf="@id/campoAutor"
                        app:layout_constraintStart_toEndOf="@id/btnMenosEstoque"
                        app:layout_constraintEnd_toStartOf="@id/btnMaisEstoque"
                        android:hint="@string/quantidade_em_estoque">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtQuantidadeEstoque"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMenosEstoque"
                        style="@style/Widget.Livraria.Botao.Contorno"
                        android:layout_width="64dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:contentDescription="@string/diminuir"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_menos"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toStartOf="@id/guiaMeio"
                        app:layout_constraintTop_toTopOf="@id/campoQuantidade"
                        app:layout_constraintBottom_toBottomOf="@id/campoQuantidade" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMaisEstoque"
                        style="@style/Widget.Livraria.Botao"
                        android:layout_width="64dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:contentDescription="@string/aumentar"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_adicionar"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:layout_constraintTop_toTopOf="@id/campoQuantidade"
                        app:layout_constraintBottom_toBottomOf="@id/campoQuantidade"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/fimPrecoQuantidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="campoPreco,campoQuantidade" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoLocal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/fimPrecoQuantidade"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:hint="@string/localizacao"
                        app:helperText="@string/localizacao_exemplo">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtLocalizacao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapSentences"
                            android:maxLength="80" />
                    </com.google.android.material.textfield.TextInputLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExcluirLivro"
                style="@style/Widget.Livraria.Botao.Perigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:minHeight="@dimen/altura_botao_grande"
                android:text="@string/excluir_livro"
                android:visibility="gone"
                app:icon="@drawable/ic_lixeira"
                tools:visibility="visible"
                app:layout_constraintTop_toTopOf="@id/btnSalvarLivro"
                app:layout_constraintBottom_toBottomOf="@id/btnSalvarLivro"
                app:layout_constraintStart_toStartOf="@id/cardFormulario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvarLivro"
                style="@style/Widget.Livraria.Botao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="@dimen/altura_botao_grande"
                android:text="@string/salvar_livro"
                android:textSize="@dimen/texto_grande"
                app:icon="@drawable/ic_ok"
                app:layout_goneMarginStart="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardFormulario"
                app:layout_constraintStart_toEndOf="@id/btnExcluirLivro"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
