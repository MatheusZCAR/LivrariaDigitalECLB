<?xml version="1.0" encoding="utf-8"?>
<!-- Vender — TABLET (barra da venda em uma linha) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ui.realizarvenda.RealizarVendaActivity">

    <include
        android:id="@+id/barraTopo"
        layout="@layout/barra_topo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoBusca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:hint="@string/buscar_livro"
        app:endIconMode="clear_text"
        app:layout_constraintEnd_toStartOf="@id/btnScan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraTopo"
        app:startIconDrawable="@drawable/ic_busca">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScan"
        style="@style/Widget.Livraria.Botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/margem_tela"
        android:text="@string/ler_codigo"
        app:icon="@drawable/ic_codigo_barras"
        app:layout_constraintBottom_toBottomOf="@id/campoBusca"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/campoBusca" />

    <TextView
        android:id="@+id/txtDica"
        style="@style/Livraria.Texto.Secundario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/margem_tela"
        android:text="@string/venda_dica"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/campoBusca" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProdutos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutCarrinho"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDica"
        tools:listitem="@layout/item_livro" />

    <TextView
        android:id="@+id/txtVazio"
        style="@style/Livraria.Texto.Corpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:textSize="@dimen/texto_grande"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recyclerProdutos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/recyclerProdutos" />

    <!-- Barra da venda em andamento -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCarrinho"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/primaria"
        android:elevation="8dp"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/iconeCarrinho"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_carrinho_venda"
            app:layout_constraintBottom_toBottomOf="@id/txtValorTotal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtTotalItens"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txtTotalItens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/white"
            android:textSize="@dimen/texto_corpo"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@id/btnLimparCarrinho"
            app:layout_constraintStart_toEndOf="@id/iconeCarrinho"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="3 livros na venda" />

        <TextView
            android:id="@+id/txtValorTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/texto_valor"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/txtTotalItens"
            app:layout_constraintStart_toStartOf="@id/txtTotalItens"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTotalItens"
            tools:text="R$ 150,00" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimparCarrinho"
            style="@style/Widget.Livraria.Botao.Contorno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/esvaziar"
            android:textColor="@color/white"
            app:icon="@drawable/ic_lixeira"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnVerCarrinho"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerCarrinho"
            style="@style/Widget.Livraria.Botao.Branco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/altura_botao_grande"
            android:text="@string/finalizar_venda"
            android:textSize="@dimen/texto_grande"
            app:icon="@drawable/ic_avancar"
            app:iconGravity="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
